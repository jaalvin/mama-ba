# The Guided Health Companion Backend Environment Variables Example

PORT=3000
NODE_ENV=development

# Google Gemini Medical AI API Keys (Primary & Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FALLBACK_API_KEY=your_gemini_fallback_api_key_here

# Supabase Cloud Database
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Khaya AI & Ghana NLP API Credentials (mama-ba & mb1 subscription keys)
KHAYA_MAMA_BA_PRIMARY_KEY=your_khaya_mama_ba_primary_key_here
KHAYA_MAMA_BA_SECONDARY_KEY=your_khaya_mama_ba_secondary_key_here
KHAYA_MB1_PRIMARY_KEY=your_khaya_mb1_primary_key_here
KHAYA_MB1_SECONDARY_KEY=your_khaya_mb1_secondary_key_here
KHAYA_API_BASE_URL=https://translation-api.ghananlp.org

# Hugging Face Access Token for Meta MMS Twi/Akan TTS
HF_TOKEN=your_hf_token_here

# Groq AI API Key (LLM Fallback when Gemini is unavailable)
GROQ_API_KEY=your_groq_api_key_here
